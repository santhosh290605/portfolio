---
import PixelWindow from "./PixelWindow.astro";
import type { LeetCodeStats } from "../data/site";

interface Props {
  stats: LeetCodeStats;
  profileUrl: string;
  compact?: boolean;
}

const { stats, profileUrl, compact = false } = Astro.props;
const maxTag = Math.max(...stats.topTags.map((t) => t.count), 1);
const maxDiff = stats.total || 1;
const handle = profileUrl.split("/u/")[1]?.replace("/", "") ?? "profile";

const easyPct = (stats.easy / maxDiff) * 100;
const medPct = (stats.medium / maxDiff) * 100;
const hardPct = (stats.hard / maxDiff) * 100;
const medEnd = easyPct + medPct;

const chartW = 280;
const chartH = 100;
const pad = 12;
const sparkPoints = stats.topTags
  .map((t, i, arr) => {
    const x = pad + (i / Math.max(arr.length - 1, 1)) * (chartW - pad * 2);
    const y = chartH - pad - (t.count / maxTag) * (chartH - pad * 2);
    return `${x},${y}`;
  })
  .join(" ");

const sparkArea = `${pad},${chartH - pad} ${sparkPoints} ${chartW - pad},${chartH - pad}`;
---

<section class="lc" aria-labelledby="lc-heading">
  <header class="lc__intro stage__head" data-reveal>
    {!compact && <span class="stage__badge">LEVEL 06</span>}
    <h2 id="lc-heading">How I stay sharp</h2>
    <p class="stage__sub">
      <span class="lc__total" data-count={stats.total}>0</span> accepted · rank #
      {stats.ranking.toLocaleString()} ·
      <a href={profileUrl} target="_blank" rel="noopener noreferrer"
        >@{handle}</a
      >
    </p>
  </header>

  <div class="lc__grid lc__grid--charts">
    <PixelWindow title="solve_rate.graph" class="win--white lc-chart-win">
      <h3 class="lc__panel-title">DIFFICULTY MIX</h3>
      <div class="lc-donut-wrap">
        <div
          class="lc-donut"
          data-lc-donut
          style={`--easy-end: ${easyPct}%; --med-end: ${medEnd}%;`}
          role="img"
          aria-label={`Easy ${stats.easy}, Medium ${stats.medium}, Hard ${stats.hard}`}
        >
          <div class="lc-donut__hole">
            <span class="lc-donut__label">TOTAL</span>
            <span class="lc-donut__num" data-count={stats.total}>0</span>
          </div>
        </div>
        <ul class="lc-legend">
          <li><span class="lc-legend__swatch lc-legend__swatch--easy"></span> Easy {stats.easy}</li>
          <li><span class="lc-legend__swatch lc-legend__swatch--med"></span> Med {stats.medium}</li>
          <li><span class="lc-legend__swatch lc-legend__swatch--hard"></span> Hard {stats.hard}</li>
        </ul>
      </div>
    </PixelWindow>

    <PixelWindow title="tag_trend.bin" class="win--white lc-chart-win">
      <h3 class="lc__panel-title">TOP TAG SIGNAL</h3>
      <svg
        class="lc-spark"
        viewBox={`0 0 ${chartW} ${chartH}`}
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="lcFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#00b8ff" stop-opacity="0.45"></stop>
            <stop offset="100%" stop-color="#00b8ff" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <polygon class="lc-spark__area" data-lc-area points={sparkArea} fill="url(#lcFill)"></polygon>
        <polyline
          class="lc-spark__line"
          data-lc-line
          points={sparkPoints}
          fill="none"
          stroke="#7c4dff"
          stroke-width="3"
          stroke-linecap="square"
          stroke-linejoin="miter"
        ></polyline>
        {
          stats.topTags.map((t, i, arr) => {
            const x = pad + (i / Math.max(arr.length - 1, 1)) * (chartW - pad * 2);
            const y = chartH - pad - (t.count / maxTag) * (chartH - pad * 2);
            return (
              <g class="lc-spark__dot" data-lc-dot={String(i)}>
                <rect
                  x={x - 4}
                  y={y - 4}
                  width="8"
                  height="8"
                  fill="#ff3d9a"
                  stroke="#1a1033"
                  stroke-width="2"
                ></rect>
              </g>
            );
          })
        }
      </svg>
      <ul class="lc-spark-labels">
        {stats.topTags.map((t) => <li>{t.name}</li>)}
      </ul>
    </PixelWindow>
  </div>

  <div class="lc__grid">
    <PixelWindow title="difficulty.bin">
      <h3 class="lc__panel-title">BY DIFFICULTY</h3>
      <ul class="lc__bars" role="list">
        <li>
          <span class="lc__label">Easy</span>
          <div class="lc__track">
            <div
              class="lc__fill lc__fill--easy"
              data-width={(stats.easy / maxDiff) * 100}
            >
            </div>
          </div>
          <span class="lc__count">{stats.easy}</span>
        </li>
        <li>
          <span class="lc__label">Med</span>
          <div class="lc__track">
            <div
              class="lc__fill lc__fill--med"
              data-width={(stats.medium / maxDiff) * 100}
            >
            </div>
          </div>
          <span class="lc__count">{stats.medium}</span>
        </li>
        <li>
          <span class="lc__label">Hard</span>
          <div class="lc__track">
            <div
              class="lc__fill lc__fill--hard"
              data-width={(stats.hard / maxDiff) * 100}
            >
            </div>
          </div>
          <span class="lc__count">{stats.hard}</span>
        </li>
      </ul>
    </PixelWindow>

    <PixelWindow title="tags.bin">
      <h3 class="lc__panel-title">TOP TAGS</h3>
      <ul class="lc__tags" role="list">
        {
          stats.topTags.map((t) => (
            <li>
              <span class="lc__tag-name">{t.name}</span>
              <div class="lc__track">
                <div
                  class="lc__fill lc__fill--tag"
                  data-width={(t.count / maxTag) * 100}
                />
              </div>
              <span class="lc__count">{t.count}</span>
            </li>
          ))
        }
      </ul>
    </PixelWindow>
  </div>
</section>

<script>
  function animateLeetCode() {
    const root = document.querySelector(".lc");
    if (!root) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    root.querySelectorAll<HTMLElement>("[data-width]").forEach((el, i) => {
      const w = el.dataset.width ?? "0";
      if (reduced) {
        el.style.width = `${w}%`;
        return;
      }
      setTimeout(() => {
        el.style.width = `${w}%`;
      }, 200 + i * 90);
    });

    const countUp = (el: HTMLElement, delay = 0) => {
      const target = Number(el.dataset.count ?? 0);
      if (reduced) {
        el.textContent = target.toLocaleString();
        return;
      }
      const duration = 1400;
      const start = performance.now() + delay;
      const tick = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        if (p <= 0) {
          requestAnimationFrame(tick);
          return;
        }
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased).toLocaleString();
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    root.querySelectorAll<HTMLElement>("[data-count]").forEach((el, i) => {
      countUp(el, i * 120);
    });

    const line = root.querySelector<SVGPolylineElement>("[data-lc-line]");
    if (line && !reduced) {
      const len = line.getTotalLength();
      line.style.strokeDasharray = `${len}`;
      line.style.strokeDashoffset = `${len}`;
      requestAnimationFrame(() => {
        line.style.transition = "stroke-dashoffset 1.4s cubic-bezier(0.22, 1, 0.36, 1)";
        line.style.strokeDashoffset = "0";
      });
    }

    const area = root.querySelector<SVGPolygonElement>("[data-lc-area]");
    if (area && !reduced) {
      area.style.opacity = "0";
      area.style.transition = "opacity 1.2s ease 0.4s";
      requestAnimationFrame(() => {
        area.style.opacity = "1";
      });
    }

    root.querySelectorAll<HTMLElement>("[data-lc-dot]").forEach((dot) => {
      if (reduced) return;
      const i = Number(dot.dataset.lcDot ?? 0);
      dot.style.opacity = "0";
      dot.style.transform = "scale(0)";
      dot.style.transformOrigin = "center";
      dot.style.transition = "opacity 0.25s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)";
      setTimeout(() => {
        dot.style.opacity = "1";
        dot.style.transform = "scale(1)";
      }, 600 + i * 100);
    });

    const donut = root.querySelector<HTMLElement>("[data-lc-donut]");
    if (donut && !reduced) {
      donut.classList.add("is-live");
    }
  }

  function boot() {
    const root = document.querySelector(".lc");
    if (!root) return;

    if (typeof IntersectionObserver === "undefined") {
      animateLeetCode();
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          animateLeetCode();
          io.disconnect();
        }
      },
      { threshold: 0.2 },
    );
    io.observe(root);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
</script>
