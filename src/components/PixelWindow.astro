---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={["win", className]}>
  <div class="win__bar">
    <div class="win__dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <span class="win__title">{title}</span>
  </div>
  <div class="win__body">
    <slot />
  </div>
</div>
