---
import Layout from "../layouts/Layout.astro";
import BootScreen from "../components/os/BootScreen.astro";
import OsWindow from "../components/os/OsWindow.astro";
import LeetCodePanel from "../components/LeetCodePanel.astro";
import { fetchLeetCodeStats } from "../lib/leetcode";
import { desktopApps, startMenuApps } from "../data/desktop";
import {
  site,
  proofPoints,
  impactLines,
  agentStory,
  systemsStory,
  researchBlurb,
  projects,
} from "../data/site";

const leetcode = await fetchLeetCodeStats();
const firstProject = projects[0]?.id ?? "fleet";
---

<Layout>
  <BootScreen />

  <div class="os-shell">
    <div class="os-desktop" id="desktop">
      <div class="os-icons" role="toolbar" aria-label="Desktop">
        {
          desktopApps.map((app) => (
            <button
              type="button"
              class="os-icon"
              data-app-id={app.id}
              data-app-type={app.type}
              data-app-href={app.href}
              style={`top: ${24 + app.row * 96}px; left: ${16 + app.col * 96}px;`}
              aria-label={app.label}
            >
              <span class="os-icon__glyph">{app.glyph}</span>
              <span>{app.label}</span>
            </button>
          ))
        }
      </div>

      <div class="os-windows" id="windows">
        <OsWindow
          id="about"
          title="C:/Users/Santhosh/AboutMe"
          left="120px"
          top="48px"
          width="min(560px, calc(100vw - 24px))"
        >
          <p class="about-lede">{site.intro}</p>
          <p class="about-role">
            <strong>{site.role}</strong> · {site.tagline}
          </p>

          <h3 class="about-proof-head">Proof, not pitch</h3>
          <ul class="proof-stack">
            {
              proofPoints.map((p) => (
                <li
                  class="proof-card proof-card--link"
                  data-open-win={p.openWin}
                  role="button"
                  tabindex="0"
                >
                  <span class="proof-card__badge">{p.badge}</span>
                  <div>
                    <strong class="proof-card__title">{p.title}</strong>
                    <p class="proof-card__detail">{p.detail}</p>
                    <span class="proof-card__pointer">↳ {p.pointer} (click)</span>
                  </div>
                </li>
              ))
            }
          </ul>

          <p class="about-target">{site.targeting}</p>
          <ul class="chips-inline">
            {site.credentials.map((c) => <li>{c}</li>)}
          </ul>
        </OsWindow>

        <OsWindow id="wins" title="C:/Career/Wins" left="160px" top="88px">
          <ul class="quest-mini">
            {
              impactLines.map((item) => (
                <li>
                  <strong>{item.stat} {item.label}</strong>
                  <p>{item.line}</p>
                </li>
              ))
            }
          </ul>
        </OsWindow>

        <OsWindow id="build" title="C:/Production/Skills" left="200px" top="72px">
          <p><strong>{systemsStory.subtitle}</strong></p>
          <div class="prose-me">
            {systemsStory.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <ul class="chips-inline">
            {systemsStory.capabilities.map((c) => <li>{c}</li>)}
          </ul>
        </OsWindow>

        <OsWindow id="agents" title="C:/AI/agents.exe" left="140px" top="100px">
          <div class="prose-me">
            {agentStory.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </OsWindow>

        <OsWindow
          id="projects"
          title="C:/Projects — File Explorer"
          left="100px"
          top="40px"
          width="min(680px, calc(100vw - 24px))"
        >
          <div class="explorer">
            <div class="explorer__tree">
              <p>📁 Projects</p>
              {
                projects.map((p) => (
                  <button
                    type="button"
                    class:list={[
                      "explorer__item",
                      p.id === firstProject && "is-active",
                    ]}
                    data-project-id={p.id}
                  >
                    📂 {p.name}
                  </button>
                ))
              }
            </div>
            <div class="explorer__main">
              {
                projects.map((p, i) => (
                  <div
                    class="explorer__panel"
                    data-project-panel={p.id}
                    hidden={i !== 0}
                  >
                    <h4>{p.name}</h4>
                    <p>{p.kind}</p>
                    <p>{p.story}</p>
                    {p.parts && (
                      <ul>
                        {p.parts.map((part) => (
                          <li>{part}</li>
                        ))}
                      </ul>
                    )}
                    <ul>
                      {p.highlights.map((h) => (
                        <li>{h}</li>
                      ))}
                    </ul>
                    <ul class="chips-inline">
                      {p.tags.map((t) => (
                        <li>{t}</li>
                      ))}
                    </ul>
                    {p.href && (
                      <p>
                        <a href={p.href} target="_blank" rel="noopener noreferrer"
                          >Open on GitHub →</a
                        >
                      </p>
                    )}
                  </div>
                ))
              }
            </div>
          </div>
        </OsWindow>

        <OsWindow
          id="leetcode"
          title="D:/Games/LeetCodeQuest"
          left="60px"
          top="36px"
          width="min(640px, calc(100vw - 24px))"
        >
          <LeetCodePanel stats={leetcode} profileUrl={site.leetcodeUrl} compact />
        </OsWindow>

        <OsWindow id="contact" title="Mail — Compose" left="180px" top="120px">
          <p>
            I'm open to AI-first and distributed-backend roles. Email me with a
            little context and I'll reply.
          </p>
          <p>{site.email}<br />{site.phone}</p>
          <div class="contact-os">
            <a class="primary" href={`mailto:${site.email}`}>EMAIL</a>
            <a href={site.resumeHref} target="_blank" rel="noopener noreferrer"
              >CV PDF</a
            >
            <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer"
              >LINKEDIN</a
            >
            <a href={site.social.github} target="_blank" rel="noopener noreferrer"
              >GITHUB</a
            >
            <a href={site.leetcodeUrl} target="_blank" rel="noopener noreferrer"
              >LEETCODE</a
            >
          </div>
        </OsWindow>

        <OsWindow id="terminal" title="SAN/OS Terminal" left="240px" top="140px" width="420px">
          <div class="term">
            <pre id="term-out" class="term__out" aria-live="polite"></pre>
            <label class="term__line">
              <span>C:\&gt;</span>
              <input
                id="term-input"
                type="text"
                autocomplete="off"
                spellcheck="false"
                aria-label="Terminal command"
              />
            </label>
          </div>
        </OsWindow>

        <OsWindow id="games" title="D:/Games" left="220px" top="64px">
          <div class="games-box">
            <p>🕹️ Mini arcade loading...</p>
            <p>
              Real boss fight is <strong>LeetCode Quest</strong> on the desktop.
              {leetcode.total.toLocaleString()} clears and counting.
            </p>
            <p class="prose-me">{researchBlurb.text}</p>
          </div>
        </OsWindow>
      </div>
    </div>

    <footer class="os-taskbar">
      <button type="button" class="os-start" id="start-btn" aria-expanded="false">
        START
      </button>
      <div class="os-taskbar__apps">
        {
          startMenuApps.map((app) => (
            <button
              type="button"
              class="os-taskbar__btn"
              data-win-id={app.id}
            >
              {app.label}
            </button>
          ))
        }
      </div>
      <button type="button" class="os-show-desktop" id="show-desktop" title="Show desktop (Alt+D)">
        ◻
      </button>
      <time class="os-clock" id="os-clock" aria-live="polite"></time>
    </footer>
  </div>

  <menu class="os-ctx" id="ctx-menu" hidden>
    <li><button type="button" data-ctx="about">Open About Me</button></li>
    <li><button type="button" data-ctx="projects">Open Projects</button></li>
    <li><button type="button" data-ctx="refresh">Refresh icons</button></li>
    <li><button type="button" data-ctx="desktop">Show desktop</button></li>
  </menu>

  <nav class="os-start-menu" id="start-menu" hidden aria-label="Start menu">
    <p class="os-start-menu__head">SAN/OS Programs</p>
    {
      startMenuApps.map((app) => (
        <button type="button" data-open-win={app.id}>
          {app.glyph} {app.label}
        </button>
      ))
    }
  </nav>
</Layout>

<script>
  import "../scripts/os-window-manager.ts";
</script>
